# GROQ_API_KEY: Required for Pieck chat and AI commands.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Meta WhatsApp Cloud API (Optional — configure in Settings > Secrets to connect live WhatsApp)
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""

# Render / Production Data Directory (set to your Render Persistent Disk mount path, e.g. /var/data)
DATA_DIR="./data"

